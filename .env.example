# Use Railway's PostgreSQL connection string in production.
DATABASE_URL=sqlite:///./stockwatch.db
JWT_SECRET=change-this-to-a-32-character-minimum-random-secret
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me-before-production
ALLOWED_ORIGINS=*
# Used by your approved connector when it POSTs incoming Myntra orders.
INTEGRATION_WEBHOOK_SECRET=change-this-to-a-long-random-webhook-secret
# Leave blank until official Myntra Seller API credentials are issued to you.
MYNTRA_API_BASE_URL=
MYNTRA_API_TOKEN=
MYNTRA_PARTNER_STORE=
MYNTRA_WAREHOUSE_CODE=
AMAZON_API_TOKEN=
FLIPKART_API_TOKEN=
AJIO_API_TOKEN=
NYKAA_API_TOKEN=
SNAPDEAL_API_TOKEN=
# Gemini is optional. Disha stays database-grounded if this is blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Meta WhatsApp Cloud API. Create and approve the stock_alert template first.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=919999999999
WHATSAPP_TEMPLATE_NAME=stock_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
